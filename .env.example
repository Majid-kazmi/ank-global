# ==========================================
# ANK GLOBAL CORPORATE PLATFORM - ENVIRONMENT CONFIGURATION
# Production Deployment on Hetzner Cloud (Coolify / Docker)
# ==========================================

# Application Environment
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://ankglobal.co

# PostgreSQL Database (Dedicated ankglobal_db)
POSTGRES_USER=ankglobal_user
POSTGRES_PASSWORD=YourStrongDatabasePassword2026!
POSTGRES_DB=ankglobal_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ankglobal_user:YourStrongDatabasePassword2026!@postgres:5432/ankglobal_db?schema=public

# Redis Configuration (Dedicated Caching & BullMQ Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YourStrongRedisPassword2026!
REDIS_URL=redis://:YourStrongRedisPassword2026!@redis:6379

# JWT Authentication Secret
JWT_SECRET=ank_global_super_secret_jwt_key_2026_at_least_64_chars_long_production_hash!
JWT_EXPIRES_IN=7d

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAyyyyyyyyyyyyyyyyyyyyy

# Transactional Email (SMTP / Resend / AWS SES)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.ankglobal.co
SMTP_PASS=YourSmtpSecretPasswordHere
SMTP_FROM="ANK Global Chartered Accountants" <info@ankglobal.co>
ADMIN_ALERT_EMAIL=info@ankglobal.co

# Public Site Configuration
NEXT_PUBLIC_API_URL=https://api.ankglobal.co/api
NEXT_PUBLIC_WHATSAPP_NUMBER=971552138281
NEXT_PUBLIC_PHONE_NUMBER="+971 55 213 8281"
NEXT_PUBLIC_SITE_URL=https://ankglobal.co
