datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MeetingType {
  VIRTUAL
  IN_PERSON
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(ADMIN)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Inquiry {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String
  company     String?
  serviceSlug String?
  serviceName String?
  message     String
  status      InquiryStatus @default(NEW)
  internalNotes String?
  sourceUrl   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model Consultation {
  id            String             @id @default(uuid())
  name          String
  email         String
  phone         String
  company       String?
  serviceSlug   String
  serviceName   String
  preferredDate DateTime
  preferredTime String
  meetingType   MeetingType        @default(VIRTUAL)
  status        ConsultationStatus @default(PENDING)
  notes         String?
  meetingLink   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([preferredDate])
  @@map("consultations")
}

model Service {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  category         String   // Tax, Audit & Assurance, Accounting, Advisory, Corporate Services, Technology
  shortDescription String
  fullDescription  String
  features         String[] // bullet points
  deliverables     String[] // key deliverables
  faqs             Json?    // list of {question, answer}
  metaTitle        String?
  metaDescription  String?
  isPublished      Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@map("services")
}

model Article {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String
  coverImage      String?
  authorName      String    @default("ANK Global Advisory Team")
  category        String    // Tax, Audit, Corporate Law, Accounting, Business Guide
  tags            String[]
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(true)
  publishedAt     DateTime  @default(now())
  readTimeMinutes Int       @default(5)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([isPublished])
  @@map("articles")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  qualification String
  bio          String
  photoUrl     String?
  linkedinUrl  String?
  email        String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("team_members")
}

model FAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String   // General, VAT, Corporate Tax, Audit, Business Setup
  serviceSlug String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("faqs")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String   @default("website_footer")
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // LOGIN, CREATE_SERVICE, UPDATE_INQUIRY, etc.
  entity    String   // Inquiry, Service, Article, etc.
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
